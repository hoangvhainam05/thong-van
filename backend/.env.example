DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=thongvan
DB_PASSWORD=thongvan
DB_DATABASE=thongvan
# Cho phép CORS (phân tách bởi dấu phẩy, hoặc '*' để cho phép tất cả domain / Vercel preview)
CORS_ORIGINS=http://localhost:3000
PORT=8000
SHIPPING_FEE=150000
FREE_SHIP_FROM=5000000

# Thông tin công khai để khách chuyển khoản thủ công; chưa kết nối cổng thanh toán.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_TRANSFER_CONTENT_PREFIX=THONGVAN

# Cloudinary: tạo API key/secret trong Dashboard; không đưa API secret lên frontend.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PRODUCTS_FOLDER=thong-van/products

# Có thể dùng DATABASE_URL thay cho các biến DB_* ở trên.
# DATABASE_URL=mysql://thongvan:thongvan@127.0.0.1:3306/thongvan

# Khóa OpenRouteService chỉ dùng ở backend (để trống để ước tính).
ORS_API_KEY=

# Tham số tối ưu
DELIVERY_DAY_START=08:00
DELIVERY_DAY_END=18:00
AVG_SPEED_KMH=30
ROAD_FACTOR=1.35
WEIGHT_KM=1.0
WEIGHT_TIME=0.5

# Thông tin liên hệ bảo hành hiển thị cho khách.
WARRANTY_CONTACT=

# Gmail và mật khẩu ứng dụng Gmail dùng để gửi OTP (không dùng mật khẩu đăng nhập).
SMTP_USER=
SMTP_PASS=
