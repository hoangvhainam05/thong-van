# Local standalone development without Vercel CLI (when backend is on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Khóa Geoapify riêng cho tile công khai; giới hạn domain và quyền tile tại Geoapify.
NEXT_PUBLIC_GEOAPIFY_TILE_KEY=

# When running with "vercel dev" or deploying to Vercel, the internal BACKEND_URL
# is automatically injected into server functions via Vercel service bindings,
# and client requests route via top-level rewrites (/api/*).
# BACKEND_URL is injected automatically — do not set it manually.
